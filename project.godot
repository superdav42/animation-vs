; Engine configuration file.
; Best edited using the Godot editor.

config_version=5

[application]

config/name="Animation VS"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]

Progress="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":65), Object(InputEventKey,"device":-1,"keycode":4194311)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":68), Object(InputEventKey,"device":-1,"keycode":4194313)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":87), Object(InputEventKey,"device":-1,"keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":83), Object(InputEventKey,"device":-1,"keycode":4194322)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":32)]
}
ability={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":81)]
}
boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":4194325)]
}

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
